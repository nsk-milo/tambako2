generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
  // binaryTargets = ["debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  category_id Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  media       media[]
}

model episodes {
  episode_id     BigInt    @id @default(autoincrement())
  season_id      BigInt
  title          String    @db.VarChar(200)
  description    String?
  episode_number Int
  duration       Int
  media_id       BigInt
  media          media     @relation(fields: [media_id], references: [media_id], onDelete: Cascade, onUpdate: NoAction)
  release_date   DateTime? @db.Date
  seasons        seasons   @relation(fields: [season_id], references: [season_id], onDelete: Cascade, onUpdate: NoAction)
  series         series?   @relation(fields: [series_id], references: [series_id])
  series_id      BigInt?

  @@unique([season_id, episode_number])
}

model genres {
  genre_id     Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  media_genres media_genres[]
}

model media {
  media_id           BigInt          @id @default(autoincrement())
  title              String          @db.VarChar(200)
  description        String?
  release_date       DateTime?       @db.Date
  category_id        Int
  duration           Int
  rating             Decimal?        @db.Decimal(2, 1)
  created_at         DateTime?       @default(now()) @db.Timestamp(6)
  media_location     String          @db.VarChar
  thumbnail_location String?         @db.VarChar
  provider_id        BigInt?
  categories         categories      @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  provider           users?          @relation(fields: [provider_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  media_genres       media_genres[]
  watch_history      watch_history[]
  episodes           episodes[]
  favorites          favorites[]
  media_views        media_views[]
}

/// One earning view: a viewer watched enough of a title — two minutes of music,
/// eight of a film or episode — to pay its creator for it. At most one row per
/// viewer, per title, per calendar month, which is what makes a view unique.
/// `payout_amount` is stamped at the time so historic earnings never move when
/// the rate changes.
model media_views {
  view_id         BigInt   @id @default(autoincrement())
  user_id         BigInt
  media_id        BigInt
  /// The creator credited, copied off the title so the earning survives the
  /// title being reassigned.
  provider_id     BigInt?
  /// Calendar month the view falls in, as `YYYY-MM`.
  month           String   @db.VarChar(7)
  seconds_watched Int
  payout_amount   Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  media           media    @relation(fields: [media_id], references: [media_id], onDelete: Cascade, onUpdate: NoAction)
  users           users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, media_id, month])
  @@index([provider_id, month])
  @@index([media_id, month])
}

model media_genres {
  media_id BigInt
  genre_id Int
  genres   genres @relation(fields: [genre_id], references: [genre_id], onDelete: Cascade, onUpdate: NoAction)
  media    media  @relation(fields: [media_id], references: [media_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([media_id, genre_id])
}

model seasons {
  season_id     BigInt     @id @default(autoincrement())
  season_number Int
  episodes      episodes[]

  @@unique([season_number])
}

model series {
  series_id  BigInt     @id @default(autoincrement())
  name       String     @db.VarChar
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  episodes   episodes[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
///
/// A plan is a price attached to a length of access. `billing_cycle` says which
/// unit that length is counted in (daily | weekly | monthly) and
/// `duration_count` how many of them one payment buys — so a three-day pass is
/// `daily` × 3 and still a daily plan, exactly like a one-day one.
model subscriptions {
  subscription_id    Int                  @id @default(autoincrement())
  /// The plan's label, e.g. `monthly` or `3-day pass`. Shown to customers.
  type               String               @unique @db.VarChar(20)
  description        String?              @db.VarChar(255)
  cost               Decimal              @db.Decimal(10, 2)
  billing_cycle      String               @default("daily") @db.VarChar(10)
  duration_count     Int                  @default(1)
  /// Retired plans stay on the row so existing subscriptions and payments keep
  /// their history; they are simply no longer offered.
  is_active          Boolean              @default(true)
  user_subscriptions user_subscriptions[]
  payments           payments[]
}

/// One row per Flutterwave charge. Created when the payment is initiated so the
/// reference and charge id can be mapped back to a user and plan whenever the
/// charge is verified — from the customer's own polling or the cron sweep.
/// `status`: pending | successful | failed | mismatch | abandoned.
model payments {
  payment_id         BigInt        @id @default(autoincrement())
  reference          String        @unique @db.VarChar(100)
  /// Flutterwave's own charge id (`chg_...`), returned by the direct-charge call.
  charge_id          String?       @unique @db.VarChar(60)
  /// Gateway-side reference, when it differs from ours.
  provider_reference String?       @db.VarChar(100)
  user_id            BigInt
  subscription_id    Int
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("ZMW") @db.VarChar(3)
  status             String        @default("pending") @db.VarChar(20)
  channel            String?       @db.VarChar(30)
  /// Mobile money network: MTN, AIRTEL or ZAMTEL.
  network            String?       @db.VarChar(20)
  failure_reason     String?       @db.VarChar(255)
  /// An upgrade replaces the customer's running plan instead of being queued
  /// behind it, and is charged at `amount` — the new plan's price less
  /// `credit_amount`, the value of the time they had left on the old one.
  is_upgrade         Boolean       @default(false)
  credit_amount      Decimal       @default(0) @db.Decimal(10, 2)
  created_at         DateTime      @default(now()) @db.Timestamp(6)
  updated_at         DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  users              users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions      subscriptions @relation(fields: [subscription_id], references: [subscription_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
}

model user_subscriptions {
  user_subscription_id BigInt         @id @default(autoincrement())
  user_id              BigInt
  subscription_id      Int
  start_date           DateTime       @db.Date
  end_date             DateTime       @db.Date
  is_active            Boolean?       @default(true)
  created_at           DateTime?      @default(now()) @db.Timestamp(6)
  updated_at           DateTime?      @default(now()) @db.Timestamp(6)
  subscriptions        subscriptions  @relation(fields: [subscription_id], references: [subscription_id], onDelete: NoAction, onUpdate: NoAction)
  users                users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  transactions         transactions[]
}

model users {
  user_id            BigInt               @id @default(autoincrement())
  name               String               @db.VarChar(100)
  email              String               @unique @db.VarChar(150)
  phone_number       String               @unique @db.VarChar(20)
  password_hash      String               @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  user_subscriptions user_subscriptions[]
  watch_history      watch_history[]
  media_views        media_views[]
  transactions       transactions[]
  favorites          favorites[]
  provided_media     media[]
  activity_logs      activity_logs[]
  payments           payments[]
  role               Role?                @relation(fields: [roleId], references: [id])
  roleId             Int?
  payouts            payouts[]            @relation("payout_provider")
  reviewed_payouts   payouts[]            @relation("payout_reviewer")
}

model transactions {
  transaction_id       BigInt             @id @default(autoincrement())
  user_id              BigInt
  user_subscription_id BigInt
  amount               Decimal            @db.Decimal(10, 2)
  created_at           DateTime?          @default(now()) @db.Timestamp(6)
  users                users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  user_subscriptions   user_subscriptions @relation(fields: [user_subscription_id], references: [user_subscription_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model watch_history {
  history_id BigInt    @id @default(autoincrement())
  user_id    BigInt
  media_id   BigInt?
  watched_at DateTime? @default(now()) @db.Timestamp(6)
  progress   Int?      @default(0)
  completed  Boolean?  @default(false)
  media      media?    @relation(fields: [media_id], references: [media_id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model favorites {
  favorite_id BigInt   @id @default(autoincrement())
  user_id     BigInt
  media_id    BigInt
  added_at    DateTime @default(now()) @db.Timestamp(6)
  media       media    @relation(fields: [media_id], references: [media_id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, media_id])
}

model activity_logs {
  log_id      BigInt   @id @default(autoincrement())
  user_id     BigInt
  action      String   @db.VarChar(50)
  details     String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// One creator cash-out, from the moment it is asked for to the moment the
/// money lands. A creator never disburses straight off their balance: they
/// request, an admin approves, and only then can the transfer be sent — so
/// `status` walks
///   requested -> approved -> processing -> paid
/// with `rejected` (admin said no) and `failed` (Flutterwave refused, or the
/// wallet bounced it) as the two ways out. Every status except `rejected` and
/// `failed` holds the amount against the creator's balance, which is what stops
/// the same earnings being requested twice.
model payouts {
  payout_id       BigInt    @id @default(autoincrement())
  /// Ours, and what we send Flutterwave as the transfer reference.
  reference       String    @unique @db.VarChar(100)
  provider_id     BigInt
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("ZMW") @db.VarChar(3)
  status          String    @default("requested") @db.VarChar(20)
  /// The creator's own carrier — MTN, AIRTEL or ZAMTEL. Kept for the record and
  /// for support; Flutterwave settles every ZMW wallet through one network code
  /// of its own (see FLW_PAYOUT_NETWORK in lib/flutterwave.ts).
  network         String    @db.VarChar(20)
  /// Destination wallet, stored in national form (`966123456`).
  phone_number    String    @db.VarChar(20)
  /// Name on the mobile money wallet, which need not be the account name.
  account_name    String    @db.VarChar(100)
  /// Flutterwave's own transfer id (`trf_...`), once the transfer is sent.
  transfer_id     String?   @unique @db.VarChar(60)
  /// Flutterwave's last word on the transfer: NEW, PENDING, SUCCESSFUL, ...
  transfer_status String?   @db.VarChar(20)
  failure_reason  String?   @db.VarChar(255)
  /// Why an admin rejected it, shown back to the creator.
  admin_note      String?   @db.VarChar(255)
  reviewed_by     BigInt?
  reviewed_at     DateTime? @db.Timestamp(6)
  paid_at         DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  provider        users     @relation("payout_provider", fields: [provider_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  reviewer        users?    @relation("payout_reviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([provider_id, status])
  @@index([status, created_at])
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleEnum
  users users[]
}

enum RoleEnum {
  ADMIN
  USER
  ContentCreator
}
